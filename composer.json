{
    "name": "jegex/laravel-media",
    "description": "Laravel media library — upload, image conversions, responsive images, video thumbnails, ZIP export, and more",
    "keywords": [
        "jegex",
        "laravel",
        "laravel-media"
    ],
    "homepage": "https://github.com/jegex/laravel-media",
    "license": "MIT",
    "authors": [
        {
            "name": "jegex",
            "email": "hujan008@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/image": "^3.3.2",
        "maennchen/zipstream-php": "^3.1",
        "spatie/temporary-directory": "^2.2"
    },
    "require-dev": {
        "ext-imagick": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.8.1",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "php-ffmpeg/php-ffmpeg": "Required for video thumbnail generation via FFMPEG"
    },
    "autoload": {
        "psr-4": {
            "Jegex\\Media\\": "src/",
            "Jegex\\Media\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jegex\\Media\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jegex\\Media\\LaravelMediaServiceProvider"
            ],
            "aliases": {
                "LaravelMedia": "Jegex\\Media\\Facades\\LaravelMedia"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
